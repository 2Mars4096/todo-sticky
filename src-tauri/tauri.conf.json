{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Sticky Todo",
  "mainBinaryName": "todo-sticky",
  "version": "../package.json",
  "identifier": "com.todo-sticky.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:frontend",
    "beforeDevCommand": "npm run dev:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sticky Todo",
        "width": 460,
        "height": 640,
        "minWidth": 340,
        "minHeight": 440,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#FFF8DC",
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "Sticky Todo",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4MDk5QkQ1RDYyQzhDODgKUldTSWpDelcxWnNKbUx1M3pFUmE2SlROQXA3WkJwNE5Ud3NFbCtFYS9tQS9KVmZ2Zy9hOFA3RzAK",
      "endpoints": [
        "https://github.com/2Mars4096/todo-sticky/releases/latest/download/latest.json"
      ]
    }
  }
}
