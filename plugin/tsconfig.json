{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@diane/plugin-sdk/*": [
        "./dev/host-contract/*"
      ]
    }
  },
  "include": [
    "src",
    "dev/**/*.ts",
    "dev/**/*.tsx",
    "vitest.config.ts"
  ]
}
